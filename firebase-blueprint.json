{
  "entities": {
    "order": {
      "title": "Order",
      "description": "Private customer order record containing PII (admin or authenticated owner only)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order ID (e.g. ORD-2026-108)",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "Formatted date and time of the order",
          "maxLength": 64
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number of the customer",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "description": "Delivery address of the customer",
          "maxLength": 300
        },
        "items": {
          "type": "array",
          "description": "Ordered items with quantities and prices"
        },
        "totalFormatted": {
          "type": "string",
          "description": "Formatted order total with currency symbol",
          "maxLength": 60
        },
        "totalUSD": {
          "type": "number",
          "description": "Order total in USD"
        },
        "discountAmountUSD": {
          "type": "number",
          "description": "Applied discount amount in USD"
        },
        "shippingFeeUSD": {
          "type": "number",
          "description": "Shipping fee in USD"
        },
        "promoCode": {
          "type": "string",
          "description": "Optional applied promo code",
          "maxLength": 32
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g. SDG, SAR, USD, AED)",
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["received", "processing", "dispatched", "delivered"],
          "description": "Current fulfillment status of the order"
        },
        "trackingCode": {
          "type": "string",
          "description": "Public parcel tracking code (e.g. TRK-98241)",
          "maxLength": 64
        },
        "ownerUid": {
          "type": "string",
          "description": "Optional Firebase Auth UID of authenticated customer",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "customerName",
        "phone",
        "address",
        "totalFormatted",
        "status",
        "trackingCode"
      ]
    },
    "tracking": {
      "title": "PublicOrderTracking",
      "description": "Sanitized public shipment status record (strictly free of customer PII)",
      "type": "object",
      "properties": {
        "trackingCode": {
          "type": "string",
          "description": "Public parcel tracking code (document ID)",
          "maxLength": 64
        },
        "orderId": {
          "type": "string",
          "description": "Reference order ID",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["received", "processing", "dispatched", "delivered"],
          "description": "Fulfillment progress status"
        },
        "date": {
          "type": "string",
          "description": "Order date string",
          "maxLength": 64
        },
        "totalFormatted": {
          "type": "string",
          "description": "Formatted order total without PII",
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last status update",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 64
        }
      },
      "required": [
        "trackingCode",
        "orderId",
        "status",
        "totalFormatted"
      ]
    },
    "review": {
      "title": "CustomerReview",
      "description": "Customer testimonial awaiting moderation or published to storefront",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique review identifier"
        },
        "name": {
          "type": "string",
          "description": "Reviewer display name",
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "description": "Reviewer city",
          "maxLength": 80
        },
        "comment": {
          "type": "string",
          "description": "Review comment body",
          "maxLength": 1000
        },
        "rating": {
          "type": "number",
          "description": "Rating score between 1 and 5"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation status enforced by security rules"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["name", "city", "comment", "rating", "status"]
    },
    "admin": {
      "title": "AdminRole",
      "description": "Store administrator authorization record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Verified administrator email"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Role designation"
        }
      },
      "required": ["email", "role"]
    },
    "storefrontConfig": {
      "title": "StorefrontConfig",
      "description": "Publicly readable store catalog, currency rates, layout ordering, and theme settings (excludes all secrets)",
      "type": "object",
      "properties": {
        "activePresetId": {
          "type": "string",
          "enum": ["cosmetics", "fashion", "eyewear", "electronics"],
          "description": "Currently active store preset key"
        },
        "presets": {
          "type": "object",
          "description": "Sanitized product catalogs and copy per niche"
        },
        "currencies": {
          "type": "object",
          "description": "Public currency conversion rates map"
        },
        "sectionsControl": {
          "type": "object",
          "description": "Visibility toggles for storefront sections"
        },
        "sectionsOrder": {
          "type": "array",
          "description": "Ordered list of storefront section IDs"
        },
        "paletteId": {
          "type": "string",
          "maxLength": 64,
          "description": "Active theme palette identifier"
        },
        "customColors": {
          "type": "object",
          "description": "Optional custom primary/accent/surface color map"
        },
        "typographyId": {
          "type": "string",
          "maxLength": 64,
          "description": "Active typography pair identifier"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last cloud publish"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of verified publishing Admin"
        }
      },
      "required": ["activePresetId", "presets", "currencies", "updatedAt"]
    },
    "userCommerceState": {
      "title": "UserCommerceState",
      "description": "Private authenticated customer cart and wishlist synchronized across devices (strictly isolated under /users/{uid}/private/commerce)",
      "type": "object",
      "properties": {
        "cart": {
          "type": "array",
          "description": "Compact array of up to 50 cart entries ({ productId, quantity, selectedVariant })"
        },
        "wishlist": {
          "type": "array",
          "description": "Deduplicated list of up to 100 wishlisted product IDs"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last cart/wishlist sync"
        }
      },
      "required": ["cart", "wishlist", "updatedAt"]
    },
    "inventoryItem": {
      "title": "InventoryItem",
      "description": "Public real-time product stock level supporting Admin updates and atomic non-negative checkout decrements",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "maxLength": 64,
          "description": "Product identifier matching document ID"
        },
        "stock": {
          "type": "integer",
          "description": "Current available inventory count (0 to 100000)"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last stock mutation"
        }
      },
      "required": ["productId", "stock", "updatedAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Private customer orders with PII — readable and securely listable only by verified Admin or authenticated owner (where ownerUid == request.auth.uid)"
    },
    "/tracking/{trackingCode}": {
      "schema": "tracking",
      "description": "Public non-PII tracking projection lookup by exact trackingCode only (no list)"
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Customer reviews — public reads restricted to status == 'approved'; creates forced to 'pending'"
    },
    "/admins/{uid}": {
      "schema": "admin",
      "description": "Admin role membership documents"
    },
    "/storefront/{docId}": {
      "schema": "storefrontConfig",
      "description": "Public single-doc storefront catalog & theme sync (readable via exact ID get; writable exclusively by verified Admin)"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "userCommerceState",
      "description": "Private customer cart & wishlist state (docId == 'commerce'), strictly readable and writable only by matching authenticated owner"
    },
    "/inventory/{productId}": {
      "schema": "inventoryItem",
      "description": "Live product stock counts — publicly readable; Admin has full CRUD; checkout updates restricted to bounded atomic decrement (<=20 units, >=0)"
    }
  }
}
