rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Master Gate: Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Request / Resource Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Tiered Identity & Role Logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'mohsentiben@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phone', 'address', 'totalFormatted', 'status', 'trackingCode'])
        && data.keys().hasOnly([
          'id', 'date', 'customerName', 'phone', 'address', 'items',
          'totalFormatted', 'totalUSD', 'discountAmountUSD', 'shippingFeeUSD',
          'promoCode', 'currency', 'status', 'trackingCode', 'ownerUid', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
        && data.address is string && data.address.size() > 0 && data.address.size() <= 300
        && (!('items' in data) || (data.items is list && data.items.size() <= 50 && (data.items.size() == 0 || data.items[0] is map)))
        && data.totalFormatted is string && data.totalFormatted.size() > 0 && data.totalFormatted.size() <= 60
        && (!('totalUSD' in data) || (data.totalUSD is number && data.totalUSD >= 0 && data.totalUSD <= 1000000))
        && (!('discountAmountUSD' in data) || (data.discountAmountUSD is number && data.discountAmountUSD >= 0 && data.discountAmountUSD <= 1000000))
        && (!('shippingFeeUSD' in data) || (data.shippingFeeUSD is number && data.shippingFeeUSD >= 0 && data.shippingFeeUSD <= 100000))
        && (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 32))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 16))
        && data.status in ['received', 'processing', 'dispatched', 'delivered']
        && data.trackingCode is string && data.trackingCode.size() > 0 && data.trackingCode.size() <= 64
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidTracking(data) {
      return data.keys().hasAll(['trackingCode', 'orderId', 'status', 'totalFormatted'])
        && data.keys().hasOnly([
          'trackingCode', 'orderId', 'status', 'date', 'totalFormatted', 'updatedAt', 'createdAt'
        ])
        && data.trackingCode is string && data.trackingCode.size() > 0 && data.trackingCode.size() <= 64
        && data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 64
        && data.status in ['received', 'processing', 'dispatched', 'delivered']
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && data.totalFormatted is string && data.totalFormatted.size() > 0 && data.totalFormatted.size() <= 60
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'city', 'comment', 'rating', 'status'])
        && data.keys().hasOnly(['name', 'city', 'comment', 'rating', 'status', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.status in ['pending', 'approved', 'rejected']
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidStorefrontConfig(data) {
      return data.keys().hasAll(['activePresetId', 'presets', 'currencies', 'updatedAt'])
        && data.keys().hasOnly([
          'activePresetId', 'presets', 'currencies', 'sectionsControl',
          'sectionsOrder', 'paletteId', 'customColors', 'typographyId',
          'updatedAt', 'updatedBy'
        ])
        && data.activePresetId in ['cosmetics', 'fashion', 'eyewear', 'electronics']
        && data.presets is map
        && data.currencies is map
        && (!('sectionsControl' in data) || data.sectionsControl is map)
        && (!('sectionsOrder' in data) || (data.sectionsOrder is list && data.sectionsOrder.size() <= 30 && (data.sectionsOrder.size() == 0 || data.sectionsOrder[0] is string)))
        && (!('paletteId' in data) || (data.paletteId is string && data.paletteId.size() <= 64))
        && (!('customColors' in data) || data.customColors is map)
        && (!('typographyId' in data) || (data.typographyId is string && data.typographyId.size() <= 64))
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (isSignedIn() && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128));
    }

    function isValidUserCommerce(data) {
      return data.keys().hasAll(['cart', 'wishlist', 'updatedAt'])
        && data.keys().hasOnly(['cart', 'wishlist', 'updatedAt'])
        && data.cart is list
        && data.cart.size() <= 50
        && (data.cart.size() == 0 || data.cart[0] is map)
        && data.wishlist is list
        && data.wishlist.size() <= 100
        && (data.wishlist.size() == 0 || data.wishlist[0] is string)
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['productId', 'stock', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'stock', 'updatedAt'])
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 64
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidCheckoutStockDecrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && existing().stock is int
        && incoming().stock is int
        && incoming().stock >= 0
        && incoming().stock < existing().stock
        && (existing().stock - incoming().stock) <= 20;
    }

    // Connection testing probe (get only, no write or list)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Private Customer Orders Collection (PII isolated to Admin or Authenticated Order Owner)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin()
        || (isSignedIn() && resource != null && 'ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)
      );
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && (incoming().status == 'received' || isAdmin())
        && (!('ownerUid' in incoming()) || (isSignedIn() && incoming().ownerUid == request.auth.uid) || isAdmin());
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Public Order Tracking Projection (Non-PII, Single-Document Lookup by Exact Tracking Code Only)
    match /tracking/{trackingCode} {
      allow get: if isValidId(trackingCode);
      allow list: if isAdmin();
      allow create: if isValidId(trackingCode)
        && isValidTracking(incoming())
        && incoming().trackingCode == trackingCode
        && (incoming().status == 'received' || isAdmin());
      allow update: if isAdmin()
        && isValidId(trackingCode)
        && isValidTracking(incoming())
        && incoming().trackingCode == existing().trackingCode
        && incoming().orderId == existing().orderId;
      allow delete: if isAdmin();
    }

    // Customer Reviews Collection (Moderation-Enforced)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource.data.status == 'approved' || isAdmin());
      allow list: if resource.data.status == 'approved' || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && (incoming().status == 'pending' || isAdmin());
      allow update: if isAdmin()
        && isValidId(reviewId)
        && isValidReview(incoming());
      allow delete: if isAdmin();
    }

    // Public Storefront Catalog & Theme Sync (Public get, strictly Admin write, zero secrets)
    match /storefront/{docId} {
      allow get: if isValidId(docId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(docId)
        && isValidStorefrontConfig(incoming());
      allow update: if isAdmin()
        && isValidId(docId)
        && isValidStorefrontConfig(incoming());
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Private Customer Cart & Wishlist State (Strictly Owner-Only under /users/{uid}/private/commerce)
    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && docId == 'commerce';
      allow list: if false;
      allow create: if isOwner(userId)
        && docId == 'commerce'
        && isValidUserCommerce(incoming());
      allow update: if isOwner(userId)
        && docId == 'commerce'
        && isValidUserCommerce(incoming());
      allow delete: if isOwner(userId) && docId == 'commerce';
    }

    // Live Public Product Inventory (Non-PII stock counts; Admin CRUD + Bounded Atomic Checkout Decrement)
    match /inventory/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidInventoryItem(incoming())
        && incoming().productId == productId;
      allow update: if isValidId(productId)
        && isValidInventoryItem(incoming())
        && incoming().productId == existing().productId
        && (isAdmin() || isValidCheckoutStockDecrement());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Admin Roles Directory
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
